<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/card_dark"
    android:fitsSystemWindows="true">

    <!-- Sticky Full-width Player with 16:9 Ratio -->
    <FrameLayout
        android:id="@+id/player_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintDimensionRatio="16:9">

        <androidx.media3.ui.PlayerView
            android:id="@+id/player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000"
            app:use_controller="true"
            app:resize_mode="fit" />

        <ImageView
            android:id="@+id/back_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="12dp"
            android:src="@drawable/ic_arrow_back"
            android:padding="8dp"
            android:layout_gravity="top|start"
            android:contentDescription="Back"
            />
    </FrameLayout>

    <!-- Scrollable Details Section -->
    <ScrollView
        android:id="@+id/details_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/player_container"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal">

            <!-- Title -->
            <TextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Movie Title"
                android:fontFamily="@font/poppins_bold"
                android:textSize="24sp"
                android:textColor="#FF5722"
                android:layout_marginBottom="4dp" />

            <!-- Genre -->
            <TextView
                android:id="@+id/tv_genre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:text="Action | Drama | 2024"
                android:textSize="14sp"
                android:textColor="#807F7F"
                android:layout_marginBottom="8dp" />

            <!-- Plot -->
            <TextView
                android:id="@+id/tv_plot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="This is the movie plot. It describes the story and background of the movie in detail."
                android:textSize="16sp"
                android:textColor="#6A6767"
                android:lineSpacingExtra="4dp"
                android:fontFamily="@font/poppins_medium"
                android:layout_marginBottom="24dp" />

            <!-- Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btn_watch_now"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:text="Watch Now"
                    android:fontFamily="@font/poppins_medium"
                    android:textAllCaps="false"
                    android:backgroundTint="#D32F2F"
                    android:textColor="@android:color/white"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_rounded_red" />

                <Button
                    android:id="@+id/btn_add_watchlist"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:text="Add to Watchlist"
                    android:fontFamily="@font/poppins_medium"
                    android:textAllCaps="false"
                    android:backgroundTint="#424242"
                    android:textColor="@android:color/white"
                    android:background="@drawable/bg_rounded_gray" />
            </LinearLayout>

            <!-- Related Movies -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Related Movies"
                android:fontFamily="@font/poppins_bold"
                android:textSize="18sp"
                android:textColor="#E76B43"
                android:layout_marginBottom="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_related"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:nestedScrollingEnabled="false"
                android:orientation="horizontal"
                android:overScrollMode="never"
                android:clipToPadding="false" />

            <!-- More Like This -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="More Like This"
                android:textColor="#E76B43"
                android:fontFamily="@font/poppins_bold"
                android:textSize="18sp"
                android:layout_marginBottom="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_more_like_this"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:orientation="horizontal"
                android:overScrollMode="never"
                android:layout_marginBottom="50dp"
                android:clipToPadding="false" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>